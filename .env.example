# Storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=personal_kb_rag

# Retrieval
INSTALL_MODEL_EXTRAS=false
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SPARSE_BACKEND=bm25_jieba
SPARSE_MODEL=Qdrant/bm25
DENSE_WEIGHT=0.55
BM25_WEIGHT=0.45
RRF_K=60
CANDIDATE_POOL=40

# Trace debugging. Keep only the most recent N API questions.
TRACE_ENABLED=true
TRACE_PATH=runtime/traces/evidence_traces.json
TRACE_RETENTION_COUNT=30
TRACE_INCLUDE_TEXT=false
TRACE_TEXT_CHARS=300
TRACE_MAX_ITEMS_PER_STAGE=20

# Optional reranking. Leave empty to skip reranking.
RERANKER_MODEL=
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8

# Optional generation backend. Empty means the local extractive answerer is used.
CHAT_MODEL_BASE_URL=
CHAT_MODEL_API_KEY=
CHAT_MODEL_NAME=

# Optional query rewrite with local Ollama. Keep disabled unless you start ollama.
QUERY_REWRITE_BACKEND=none
QUERY_REWRITE_MODEL=qwen3.5:9b
QUERY_REWRITE_TIMEOUT_SECONDS=60

# Intent routing uses Ollama structured JSON Schema output. Low confidence falls back to RAG.
INTENT_ROUTER_BACKEND=ollama
INTENT_ROUTER_BASE_URL=http://localhost:11434
INTENT_ROUTER_MODEL=qwen3.5:9b
INTENT_ROUTER_TIMEOUT_SECONDS=60
INTENT_ROUTER_LOW_CONFIDENCE_THRESHOLD=0.75
INTENT_ROUTER_CONTEXT_TURNS=5
