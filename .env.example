# Storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_rag

# Retrieval
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
SPARSE_MODEL=Qdrant/bm25
DENSE_WEIGHT=0.55
BM25_WEIGHT=0.45
RRF_K=60
CANDIDATE_POOL=40

# Optional reranking. Leave empty to skip reranking.
RERANKER_MODEL=
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8

# Optional generation backend. Empty means the local extractive answerer is used.
CHAT_MODEL_BASE_URL=
CHAT_MODEL_API_KEY=
CHAT_MODEL_NAME=
